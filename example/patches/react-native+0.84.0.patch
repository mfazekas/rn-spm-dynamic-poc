+  # $1 is the framework name, $2 the build directory of the pod using it. Xcode puts binary targets next to
+  # the pod, and source packages in PackageFrameworks (UninstalledProducts when archiving). Frameworks that
+  # are missing (the product is not dynamic) or statically linked are part of their consumer already.
+  EMBED_FUNCTION_SOURCE = <<~'SH'
+    install_spm_framework()
+    {
+      local dir
+      for dir in "$2" "${PODS_CONFIGURATION_BUILD_DIR}/PackageFrameworks" "${OBJROOT}/UninstalledProducts/${PLATFORM_NAME}"; do
+        if [ -d "$dir/$1.framework" ]; then
+          if file -b "$dir/$1.framework/$1" | grep -q "dynamically linked"; then
+            install_framework "$dir/$1.framework"
+          fi
+          return
+        fi
+      done
+    }
