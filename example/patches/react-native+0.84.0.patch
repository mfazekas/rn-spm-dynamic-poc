@@ -53,6 +80,51 @@ class SPMManager
 
   private
 
+  # CocoaPods' "[CP] Embed Pods Frameworks" only embeds frameworks it knows about, so dynamic
+  # frameworks that Swift packages add to a pod never reach the app bundle and the app fails at launch
+  # with dyld "Library not loaded" (in Debug simulator builds source packages still load, through an
+  # rpath into the build directory).
+  def add_embed_frameworks(installer)
+    installer.aggregate_targets.each do |aggregate_target|
+      pod_targets = aggregate_target.pod_targets.select { |t| @dependencies_by_pod.key?(t.name) }
+      script_path = aggregate_target.embed_frameworks_script_path
+      next if pod_targets.empty? || !File.exist?(script_path)
+
+      script = File.read(script_path)
+      next if script.include?("#{EMBED_FUNCTION}()")
+      anchor = /^if \[ "\$\{COCOAPODS_PARALLEL_CODE_SIGN\}" == "true" \]; then$/
+      unless script.match?(anchor)
+        log_warning "Could not embed Swift package frameworks in #{script_path}, the app might fail to launch"
+        next
+      end
+
+      calls = pod_targets.map do |pod_target|
+        dependencies = @dependencies_by_pod[pod_target.name]
+        frameworks = dependencies.flat_map { |d| d[:embed_frameworks] }.uniq
+        # The requirements are listed so that changing them changes this script, which is an input of
+        # the embed phase, and the phase runs again.
+        "# #{pod_target.name}: #{dependencies.map { |d| "#{d[:url]} #{d[:requirement]}" }.join(', ')}\n" +
+          frameworks.map { |f| "#{EMBED_FUNCTION} \"#{f}\" \"${PODS_CONFIGURATION_BUILD_DIR}/#{pod_target.label}\"\n" }.join
+      end
+      File.write(script_path, script.sub(anchor) { "#{EMBED_FUNCTION_SOURCE}#{calls.join}#{$&}" })
+      log " Embedding Swift package frameworks of #{pod_targets.map(&:name).join(', ')} in #{aggregate_target.name}"
+    end
+  end
+
+  # Xcode processes a binary target's xcframework both for the pod and for the app that links it, and
+  # Xcode 26 archives fail on the two identically named signatures ("... .xcframework-ios.signature
+  # couldn't be copied to Signatures because an item with the same name already exists").
+  def add_signature_cleanup(project)
+    @dependencies_by_pod.each_key do |pod_name|
+      target = project.targets.find { |t| t.name == pod_name }
+      next unless target
+      phase = target.shell_script_build_phases.find { |p| p.name == SIGNATURE_PHASE_NAME } ||
+        target.new_shell_script_build_phase(SIGNATURE_PHASE_NAME)
+      phase.shell_script = 'rm -f "${CONFIGURATION_BUILD_DIR}"/*.xcframework-*.signature'
+      phase.always_out_of_date = '1'
+    end
+  end
+
   def log(msg)
     ::Pod::UI.puts "[SPM] #{msg}"
   end
